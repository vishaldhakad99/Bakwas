# ==============================================================================
# BAKWAS REAL-TIME MESSAGING PLATFORM - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Server Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-domain.vercel.app

# MongoDB Atlas Production Connection URI
# Obtain from MongoDB Atlas -> Database -> Connect -> Drivers (Node.js)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bakwas?retryWrites=true&w=majority

# Cryptographic JWT Authentication Secrets (Min 32 characters high-entropy strings)
JWT_ACCESS_SECRET=your_super_secret_high_entropy_jwt_access_secret_key_2026_xyz
JWT_REFRESH_SECRET=your_super_secret_high_entropy_jwt_refresh_secret_key_2026_abc
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Real SMS OTP Provider Configuration
# Choose: 'twilio' | 'msg91' | 'mock'
SMS_PROVIDER=twilio

# Twilio SMS Provider Credentials
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 Provider Credentials (Alternative)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# Cloud Media Storage Configuration (Cloudinary)
# Choose: 'cloudinary' | 'local'
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# WebPush VAPID Keys (Generate using `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@bakwas.chat

# STUN / TURN Server for WebRTC Crossing Symmetric NATs (e.g. Metered, Twilio Network Traversal, or coturn)
TURN_URL=turn:global.turn.twilio.com:3478?transport=udp
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential_password
